# Supabase Postgres connection string
# Find it in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use the "Connection pooling" URI (port 6543) when deploying to Render, it handles
# serverless/many-short-lived-connections better than the direct connection (port 5432).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Port the Express server listens on (Render sets this automatically in production)
PORT=3000

# Optional simple shared-secret auth for the POST endpoint (recommended for a device in the field)
DEVICE_API_KEY=change-this-to-a-long-random-string
